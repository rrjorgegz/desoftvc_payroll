<odoo>

    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <field name="contract_id" position="after">
                <field name="wage" />
                <field name="hw" />
            </field>
            <xpath expr="//notebook" position="before">
                <group class="a1">
                    <group class="b1">
                        <field name="paid_add" />
                        <field name="paid_value" />
                    </group>
                    <group class="b1" />
                </group>
                <group class="a2" />
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree_inherit" model="ir.ui.view">
        <field name="name">view.hr.payslip.tree.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="wage" />
                <field name="hw" />
                <field name="paid_add" />
                <field name="paid_value" />
            </xpath>
        </field>
    </record>

</odoo>
